{
  "name": "baixaria-fina",
  "version": "0.5.0-beta.3",
  "private": true,
  "description": "Monorepo: mixerCraft (apps/mixer, desktop) e Academy (apps/academy). O pacote Electron da raiz é o Mixer.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main/main.cjs",
  "workspaces": [
    "apps/mixer",
    "apps/academy",
    "packages/music-theory",
    "packages/audio-synth",
    "packages/ui-core",
    "packages/exchange-contract"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/academy/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:renderer": "vite build",
    "build:electron": "esbuild apps/mixer/src/main/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/main.cjs && esbuild apps/mixer/src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.cjs",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win --dir -c apps/mixer/electron-builder.json",
    "dist:win": "npm run build && electron-builder --win -c apps/mixer/electron-builder.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "playwright": "^1.65.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.16.0"
  },
  "author": "Baixaria Fina (local)"
}
