{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@domain": ["apps/academy/src/domain/index.ts"],
      "@baixaria/music-theory": ["packages/music-theory/src/index.ts"],
      "@baixaria/audio-synth": ["packages/audio-synth/src/index.ts"],
      "@baixaria/ui-core": ["packages/ui-core/src/index.ts"],
      "@baixaria/exchange-contract": ["packages/exchange-contract/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "apps/mixer/src/**/*.ts", "apps/mixer/src/**/*.tsx", "apps/mixer/tests/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
